# Meridian Cloud v3.0
# Primary market source: Yahoo/yfinance. No local IBKR Gateway is required.
MARKET_DATA_PROVIDER=yahoo
YAHOO_CORE_REFRESH_SECONDS=300

# 100% free news/event pipeline: GDELT + SEC EDGAR + official Fed/BLS RSS.
NEWS_PROVIDER=free
RESEARCH_CACHE_SECONDS=900
FREE_NEWS_TIMEOUT=12

# SEC asks automated clients to identify themselves with a contact address.
# Example: SEC_USER_AGENT=Meridian you@example.com
SEC_USER_AGENT=

# Strongly recommended for the public cloud URL.
MERIDIAN_PASSWORD=

# Optional AI research/customization. Not required for scanner/news/prices.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
NEWS_MODEL=gpt-5.6-luna

# Local-only legacy mode remains available if ever needed:
# MARKET_DATA_PROVIDER=ibkr
# IBKR_GATEWAY_URL=https://localhost:5000/v1/api
